{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app:app"
    },
    "ca-audit-suite": {
      "root": "ca-audit-suite",
      "runtime": "python",
      "entrypoint": "app:app",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "ca-audit-suite"
      }
    }
  ]
}
